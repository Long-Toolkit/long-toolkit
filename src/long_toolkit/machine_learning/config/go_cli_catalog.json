            "default": false,
            "when": {
              "field": "generate_notebook",
              "equals": true
            }
          },
          {
            "key": "generate_pipeline_profiler_html",
            "label": "Generate PipelineProfiler HTML",
            "type": "bool",
            "required": true,
            "default": false
          }
        ]
      },
