{
  "standard_machine_learning": {
    "techniques": [
      {
        "id": "run_experiment",
        "name": "Run Experiment",
        "description": "Train and evaluate one standard (cross-sectional) estimator.",
        "parameters": [
          {
            "key": "input_path",
            "label": "Input CSV path",
            "type": "path",
            "required": true,
            "hint": "Tabular dataset in wide format."
          },
          {
            "key": "target_column",
            "label": "Target column",
            "type": "string",
            "required": true,
            "default": "target",
            "hint": "Classification target column."
          },
          {
            "key": "feature_columns",
            "label": "Feature columns",
            "type": "string",
            "required": true,
            "default": "auto",
            "hint": "Comma-separated list or `auto` for all except target."
          },
          {
            "key": "estimator_key",
            "label": "Estimator key",
            "type": "string",
            "required": false,
            "hint": "Optional; defaults to the first discovered estimator."
          },
          {
            "key": "metric_keys",
            "label": "Metric keys",
            "type": "string",
            "required": true,
            "default": "f1_macro",
            "hint": "Comma-separated metrics (e.g. f1_macro, auroc)."
          },
          {
            "key": "evaluation_strategy",
            "label": "Evaluation strategy",
            "type": "enum",
            "required": true,
            "default": "cross_validation",
            "options": [
              {
                "label": "Cross-validation",
                "value": "cross_validation"
              },
              {
                "label": "Holdout",
                "value": "holdout"
              }
            ],
            "hint": "Choose between stratified k-fold cross-validation and repeated stratified holdout evaluation."
          },
          {
            "key": "n_splits",
            "label": "Number of splits",
            "type": "int",
            "required": true,
            "default": 10,
            "min": 2,
            "hint": "For cross-validation, this is the number of folds. For holdout, this is the number of repeated random splits."
          },
          {
            "key": "holdout_split",
            "label": "Holdout split",
            "type": "string",
            "required": true,
            "default": "80/20",
            "hint": "Train/validation ratio like `80/20` or validation fraction like `0.2`.",
            "when": {
              "field": "evaluation_strategy",
              "equals": "holdout"
            }
          },
          {
            "key": "random_seed",
            "label": "Random seed",
            "type": "int",
            "required": true,
            "default": 42
          },
          {
            "key": "output_dir",
            "label": "Output directory",
            "type": "path",
            "required": false,
            "hint": "Defaults to outputs/standard_ml/<estimator_key>."
          },
          {
            "key": "hyperparameters_json",
            "label": "Hyperparameters JSON",
            "type": "json",
            "required": false,
            "default": {},
            "hint": "Estimator constructor overrides as JSON object."
          },
          {
            "key": "missing_value_imputation_enabled",
            "label": "Add missing-value imputation step",
            "type": "bool",
            "required": true,
            "default": false,
            "hint": "Fits the imputer on each training split only, then reuses the fitted pipeline at prediction time."
          },
          {
            "key": "missing_value_imputation_strategy",
            "label": "Missing-value imputation strategy",
            "type": "enum",
            "required": true,
            "default": "mean",
            "options": [
              {
                "label": "mean",
                "value": "mean"
              },
              {
                "label": "median",
                "value": "median"
              },
              {
                "label": "most_frequent",
                "value": "most_frequent"
              },
              {
                "label": "constant",
                "value": "constant"
              }
            ],
            "hint": "Shown only when you choose to add an imputation step.",
            "when": {
              "field": "missing_value_imputation_enabled",
              "equals": true
            }
          },
          {
            "key": "multiclass_mode",
            "label": "Multiclass mode",
            "type": "enum",
            "required": true,
            "default": "multiclass",
            "options": [
              {
                "label": "Multiclass",
                "value": "multiclass"
              },
              {
                "label": "One-vs-rest",
                "value": "one_vs_rest"
              }
            ],
            "hint": "Used only when the target has more than two classes. Binary targets ignore this setting."
          },
          {
            "key": "silent_training_output",
            "label": "Silent training output",
            "type": "bool",
            "required": true,
            "default": true
          },
          {
            "key": "generate_notebook",
            "label": "Generate reproducibility notebook",
            "type": "bool",
            "required": true,
            "default": true
          },
          {
            "key": "notebook_output_path",
            "label": "Notebook output path",
            "type": "path",
            "required": false,
            "hint": "Used only when notebook generation is enabled.",
            "when": {
              "field": "generate_notebook",
              "equals": true
            }
          }
        ]
      },
      {
        "id": "list_estimators",
        "name": "List Estimators",
        "description": "List discoverable standard estimators and metadata.",
        "parameters": []
      },
      {
        "id": "list_metrics",
        "name": "List Metrics",
        "description": "List all supported metrics for standard experiments.",
        "parameters": []
      }
    ]
  },
