            "when": {
              "field": "missing_value_imputation_enabled",
              "equals": true
            }
          },
          {
            "key": "max_parallel_candidates",
            "label": "Max parallel candidates",
            "type": "int",
            "required": true,
            "default": 1,
            "min": 1,
            "hint": "Maximum number of candidate estimators to train concurrently within each benchmark run."
          },
          {
            "key": "silent_training_output",
            "label": "Silent training output",
            "type": "bool",
            "required": true,
            "default": true
          },
          {
            "key": "generate_notebook",
            "label": "Generate reproducibility notebook",
            "type": "bool",
            "required": true,
            "default": true
          },
          {
            "key": "notebook_output_path",
            "label": "Notebook output path",
            "type": "path",
            "required": false,
            "when": {
              "field": "generate_notebook",
              "equals": true
            }
          },
          {
            "key": "include_pipeline_profiler_at_end",
            "label": "Include PipelineProfiler at notebook end",
            "type": "bool",
