          {
            "key": "hyperparameters_json",
            "label": "Global hyperparameters JSON",
            "type": "json",
            "required": false,
            "default": {},
            "hint": "Global estimator constructor overrides as JSON object. Keys unsupported by a given estimator are ignored."
          },
          {
            "key": "missing_value_imputation_enabled",
            "label": "Add missing-value imputation step",
            "type": "bool",
            "required": true,
            "default": false,
            "hint": "Fits the imputer on each training split only for every benchmarked estimator."
          },
          {
            "key": "missing_value_imputation_strategy",
            "label": "Missing-value imputation strategy",
